@page
@model Visunovia.Pages.SetupWizardModel
@using Visunovia.Services.Localization
@inject IStringLocalizer Localizer
@{
    Layout = "_Layout";
}

<!-- Setup Wizard Overlay -->
<div id="setupWizardOverlay" style="display:flex; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.85); z-index:10000; justify-content:center; align-items:center; flex-direction:column;">

    <!-- Progress Steps -->
    <div id="wizardProgress" style="display:flex; gap:8px; margin-bottom:32px;">
        <div class="wizard-step-dot active" data-step="0" style="width:12px; height:12px; border-radius:50%; background:#3B82F6; transition:all 0.3s;"></div>
        <div class="wizard-step-dot" data-step="1" style="width:12px; height:12px; border-radius:50%; background:#444; transition:all 0.3s;"></div>
        <div class="wizard-step-dot" data-step="2" style="width:12px; height:12px; border-radius:50%; background:#444; transition:all 0.3s;"></div>
    </div>

    <!-- Wizard Card -->
    <div id="wizardCard" style="width:520px; background:#1a1a1a; border:1px solid #333; border-radius:12px; overflow:hidden; box-shadow:0 20px 60px rgba(0,0,0,0.5);">

        <!-- Header -->
        <div style="padding:24px 28px 16px 28px; border-bottom:1px solid #222;">
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:4px;">
                <span style="font-size:20px;">🚀</span>
                <span style="color:white; font-size:18px; font-weight:bold;" id="wizardTitle">@Localizer["SetupWizard.Title"]</span>
            </div>
            <div id="wizardSubtitle" style="color:#666; font-size:13px; margin-left:30px;">@Localizer["SetupWizard.StepLanguageDesc"]</div>
        </div>

        <!-- Body -->
        <div id="wizardBody" style="padding:24px 28px; min-height:220px;">

            <!-- Step 0: Language Selection -->
            <div id="wizardStep0" class="wizard-step">
                <div style="color:#aaa; font-size:13px; margin-bottom:12px;">@Localizer["SetupWizard.StepLanguage"]</div>
                <div id="systemLanguageDetection" style="padding:10px 14px; background:#0d0d0d; border:1px solid #333; border-radius:6px; margin-bottom:16px; font-size:13px; color:#999;"></div>
                <div id="languageList" style="display:flex; flex-direction:column; gap:6px; max-height:200px; overflow-y:auto;">
                    <!-- Populated by JS -->
                </div>
                <div id="noLanguageFilesWarning" style="display:none; padding:10px 14px; background:#2a1a00; border:1px solid #F59E0B; border-radius:6px; margin-top:12px; font-size:12px; color:#F59E0B;">
                    @Localizer["SetupWizard.NoLanguageFiles"]
                </div>
            </div>

            <!-- Step 1: Theme Selection -->
            <div id="wizardStep1" class="wizard-step" style="display:none;">
                <div style="color:#aaa; font-size:13px; margin-bottom:12px;">@Localizer["SetupWizard.StepTheme"]</div>
                <div style="display:flex; flex-direction:column; gap:8px;">
                    <label style="display:flex; align-items:center; gap:12px; padding:14px 16px; background:#0d0d0d; border:1px solid #333; border-radius:8px; cursor:pointer; transition:all 0.2s;" class="theme-option" data-theme="dark">
                        <input type="radio" name="theme" value="dark" style="accent-color:#3B82F6;" />
                        <div style="flex:1;">
                            <div style="color:#ddd; font-size:14px;">@Localizer["SetupWizard.ThemeDark"]</div>
                        </div>
                        <div style="width:24px; height:24px; background:#1a1a1a; border:2px solid #555; border-radius:4px;"></div>
                    </label>
                    <label style="display:flex; align-items:center; gap:12px; padding:14px 16px; background:#0d0d0d; border:1px solid #333; border-radius:8px; cursor:pointer; transition:all 0.2s;" class="theme-option" data-theme="light">
                        <input type="radio" name="theme" value="light" style="accent-color:#3B82F6;" />
                        <div style="flex:1;">
                            <div style="color:#ddd; font-size:14px;">@Localizer["SetupWizard.ThemeLight"]</div>
                        </div>
                        <div style="width:24px; height:24px; background:#f5f5f5; border:2px solid #ccc; border-radius:4px;"></div>
                    </label>
                    <label style="display:flex; align-items:center; gap:12px; padding:14px 16px; background:#0d0d0d; border:1px solid #333; border-radius:8px; cursor:pointer; transition:all 0.2s;" class="theme-option" data-theme="system">
                        <input type="radio" name="theme" value="system" checked style="accent-color:#3B82F6;" />
                        <div style="flex:1;">
                            <div style="color:#ddd; font-size:14px;">@Localizer["SetupWizard.ThemeSystem"]</div>
                        </div>
                        <div style="width:24px; height:24px; background:linear-gradient(135deg, #1a1a1a 50%, #f5f5f5 50%); border:2px solid #555; border-radius:4px;"></div>
                    </label>
                </div>
            </div>

            <!-- Step 2: Finish -->
            <div id="wizardStep2" class="wizard-step" style="display:none; text-align:center; padding:20px 0;">
                <div style="font-size:48px; margin-bottom:16px;">✅</div>
                <div style="color:white; font-size:18px; font-weight:bold; margin-bottom:8px;">@Localizer["SetupWizard.StepFinish"]</div>
                <div style="color:#999; font-size:13px; line-height:1.6;">@Localizer["SetupWizard.StepFinishDesc"]</div>
            </div>

        </div>

        <!-- Footer / Navigation -->
        <div id="wizardFooter" style="padding:16px 28px; border-top:1px solid #222; display:flex; justify-content:space-between; align-items:center;">
            <button id="wizardBackBtn" class="toolbar-btn" onclick="wizard.goBack()" style="display:none;">@Localizer["SetupWizard.BackButton"]</button>
            <button id="wizardSkipBtn" class="toolbar-btn" onclick="wizard.skip()" style="color:#666;">@Localizer["SetupWizard.SkipButton"]</button>
            <button id="wizardNextBtn" class="accent-btn toolbar-btn" onclick="wizard.goNext()" style="padding:8px 20px;">@Localizer["SetupWizard.NextButton"]</button>
        </div>
    </div>
</div>

<script src="~/js/setup-wizard.js"></script>
