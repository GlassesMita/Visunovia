root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
indent_size = 4

[*.cshtml]
indent_size = 4

[*.{js,ts,jsx,tsx,mjs,cjs}]
indent_size = 2
max_line_length = 100

[*.json]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.{css,scss,sass,less}]
indent_size = 2

[*.{html,htm}]
indent_size = 2

[*.po]
indent_size = 2

[*.{ini,toml,conf}]
indent_size = 2

[*.{sln,csproj,vbproj,fsproj}]
indent_style = tab
indent_size = 2

[*.sh]
end_of_line = lf
indent_size = 2

[*.{cmd,bat}]
end_of_line = crlf
