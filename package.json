{
  "name": "visunovia",
  "version": "1.0.0",
  "description": "Visunovia 是一款基于 Web 的视觉小说编辑器，采用现代化的技术栈，提供直观的节点图编辑器和实时预览功能。",
  "main": "apps/editor-desktop/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n client,electron -c cyan,green \"npm run client:dev\" \"npm run desktop:dev\"",
    "client:dev": "npm --prefix visunovia.client run dev",
    "client:build": "npm --prefix visunovia.client run build",
    "client:preview": "npm --prefix visunovia.client run preview",
    "desktop:dev": "electron apps/editor-desktop/main.cjs --dev",
    "desktop:start": "electron apps/editor-desktop/main.cjs",
    "desktop:pack": "npm run client:build && electron-builder --dir",
    "desktop:pack:local": "npm run client:build && electron-builder --dir --config.electronDist=node_modules/electron/dist",
    "player:desktop:dev": "electron apps/player-desktop/main.cjs --dev",
    "player:desktop:start": "electron apps/player-desktop/main.cjs",
    "player:desktop:pack:local": "npm run client:build && electron-builder --dir --projectDir apps/player-desktop --config electron-builder.json"
  },
  "build": {
    "appId": "com.visunovia.editor",
    "productName": "Visunovia Editor",
    "directories": {
      "output": "dist-desktop"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "apps/editor-desktop/**/*",
      "apps/player-desktop/**/*",
      "Localizations/**/*",
      "www_build/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "dir"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GlassesMita/Visunovia.git"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/GlassesMita/Visunovia/issues"
  },
  "homepage": "https://github.com/GlassesMita/Visunovia#readme",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "concurrently": "^9.2.1",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  }
}
