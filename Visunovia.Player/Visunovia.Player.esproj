<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.979102">
  <PropertyGroup>
    <StartupCommand>npm run dev</StartupCommand>
    <BuildCommand>npm run build</BuildCommand>
    <WorkingDirectory>$(MSBuildProjectDirectory)</WorkingDirectory>
    <OutputPath>$(MSBuildProjectDirectory)\..\www_player_build</OutputPath>
    <ShouldRunNpmInstall>true</ShouldRunNpmInstall>
    <ShouldRunBuildScript>false</ShouldRunBuildScript>
  </PropertyGroup>
</Project>